# Mail destination (where leads should go)
HRMETRICS_LEAD_TO=sales@example.com

# SMTP config (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=yourgmail@gmail.com
SMTP_PASS=your_app_password

# Optional: customize From header
MAIL_FROM_NAME=HRMetricS Website
MAIL_FROM_EMAIL=yourgmail@gmail.com

# Server port
PORT=3001

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=change_this_session_secret
