{
  "name": "cloned-site-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n client,server -c green,cyan \"vite\" \"node server/dev-server.cjs\"",
    "dev:client": "vite",
    "dev:server": "node server/dev-server.cjs",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node server/server.cjs",
    "pm2:start": "pm2 start ecosystem.config.cjs --env production",
    "pm2:stop": "pm2 stop hrmetrics",
    "pm2:restart": "pm2 restart hrmetrics",
    "pm2:reload": "pm2 reload hrmetrics",
    "pm2:logs": "pm2 logs hrmetrics",
    "pm2:status": "pm2 status",
    "pm2:save": "pm2 save"
  },
  "dependencies": {
    "better-sqlite3": "^12.8.0",
    "cookie": "^1.1.1",
    "cors": "^2.8.5",
