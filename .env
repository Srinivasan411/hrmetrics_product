# Mail destination (where leads should go)
HRMETRICS_LEAD_TO=seenivasan@bsyssolutions.com

# SMTP config (Gmail example: use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seenivasan@bsyssolutions.com
SMTP_PASS=your_app_password_here

# Optional: customize From header
MAIL_FROM_NAME=HRMetricS Website
MAIL_FROM_EMAIL=seenivasan@bsyssolutions.com

# Server port
PORT=3002

# Admin login
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_SESSION_SECRET=your_very_secure_session_secret_here

# Admin session cookie options (optional)
# ADMIN_COOKIE_SAMESITE=lax   # lax | strict | none (none forces secure=true)
# ADMIN_COOKIE_SECURE=false   # true/false (ignored when sameSite=none)
# ADMIN_COOKIE_DOMAIN=example.com
# ADMIN_COOKIE_PATH=/